<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="EmployeeDetails" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <documentation textFormat="text/plain">
            <text><![CDATA[Onboarding step 1 - Employee details. Owner: HR. The "Details" object is personal data: the devplan backend reads and writes it in its own database (x-pii "employee"), never in the case file. Its field list, titles, required-ness and layout come from the employee table's own columns and column comments (see migration V13__employee_details_schema_from_db.sql / forms/TableStore.java), not from this task-model - the case model only carries the "x-pii": "employee" routing marker. On complete the backend creates the account and returns the Employee case item.]]></text>
        </documentation>
        <input id="i_Employee__employee_details" name="Employee" typeRef="dv_employee.type"/>
        <output id="o_Employee__employee_details" name="Employee" typeRef="dv_employee.type"/>
        <output id="swag__G4OQ" name="swag" typeRef="dv_swag.type"/>
        <task-model>{
  "schema": {
    "title": "Employee details",
    "description": "Personal details and the role of the new employee. Save draft keeps the form; Save &amp; continue creates the account and opens the Equipment request by HR.",
    "type": "object",
    "properties": {
      "Details": {
        "type": "object",
        "x-pii": "employee",
        "x-on-complete": "createEmployee"
      },
      "swag": {
        "type": "object",
        "title": "Welcome kit",
        "properties": {
          "size": {
            "type": "string",
            "title": "T-shirt size",
            "oneOf": [
              { "const": "S", "title": "S" },
              { "const": "M", "title": "M" },
              { "const": "L", "title": "L" },
              { "const": "XL", "title": "XL" }
            ]
          },
          "hoodieSize": {
            "type": "string",
            "title": "Hoodie size",
            "oneOf": [
              { "const": "S", "title": "S" },
              { "const": "M", "title": "M" },
              { "const": "L", "title": "L" },
              { "const": "XL", "title": "XL" }
            ]
          }
        }
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
          { "type": "PiiSection", "scope": "#/properties/Details" },
          {
        "type": "Group",
        "label": "Welcome kit",
        "elements": [
          { "type": "Control", "scope": "#/properties/swag/properties/size" },
          { "type": "Control", "scope": "#/properties/swag/properties/hoodieSize" }
        ]
      }
    ]
  },
  "submitLabel": "Save &amp; continue"
}</task-model>
    </cafienne:implementation>
</humanTask>
