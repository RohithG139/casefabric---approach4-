# Template for running the CaseFabric stack (this folder) on a real server.
#
# Copy this file to ".env" in this same folder and fill in real values, THEN run:
#   docker compose up -d
#
# Do not commit the filled-in .env file anywhere (it holds passwords/secrets).

COMPOSE_PROJECT_NAME=case-management-getting-started

# ---- Public hostname of Keycloak (the browser must be able to reach this) ----
# Use the real domain/subdomain you put Keycloak behind, with https in production.
# Example: https://auth.yourcompany.com
KEYCLOAK_PUBLIC_URL=http://localhost:8280

# These 3 lines must all resolve to the SAME host as KEYCLOAK_PUBLIC_URL above
# (docker compose can't derive one from another, so set them to matching values by hand).
OIDC_URI=http://localhost:8280/realms/devplan
CAFIENNE_OIDC_AUTHORIZATION_URL=http://localhost:8280/realms/devplan/protocol/openid-connect/auth
CAFIENNE_OIDC_ISSUER=http://localhost:8280/realms/devplan

# ---- Public hostname of the case engine API (the browser / Case UI reaches this) ----
# Example: https://api.yourcompany.com
CAFIENNE_URI=http://localhost:2027

# ---- Secrets: change ALL of these before exposing anything publicly ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-to-a-strong-password

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
# The case engine's own DB credentials point at the same Postgres instance above;
# keep these equal to POSTGRES_PASSWORD unless you split it into separate databases/users.
EVENT_DB_USER=postgres
EVENT_DB_PASSWORD=change-me-to-a-strong-password
QUERY_DB_USER=postgres
QUERY_DB_PASSWORD=change-me-to-a-strong-password

# ---- Before the first "docker compose up" on a fresh server, also edit by hand: ----
# src/keycloak/devplan-realm.json
#   - client "devplan-web"         -> redirectUris / webOrigins -> your devplan-app public URL
#   - client "case-user-interface" -> redirectUris / webOrigins -> your Case UI public URL
#   - client "swagger-ui"          -> redirectUris / webOrigins -> your engine API public URL
#   - client "devplan-backend"     -> "secret" -> a new value, matching DEVPLAN_BACKEND_CLIENT_SECRET
#     in devplan-app/.env (see devplan-app/.env.production.example)
# This file is only imported the first time Keycloak starts against an empty database, so edit it
# BEFORE the first "docker compose up" on the new server, not after.
