# Template for running the Development plan app (this folder) on a real server.
# The CaseFabric stack (../getting-started) must already be running with ITS OWN .env configured
# (see ../getting-started/.env.production.example) before you start this one.
#
# Copy this file to ".env" in this same folder and fill in real values, THEN run:
#   docker compose up -d --build
#
# Do not commit the filled-in .env file anywhere (it holds passwords/secrets).

# Port this app is published on (map a domain to this port in your reverse proxy)
DEVPLAN_PORT=8090
# Public URL users reach this app on (must match the client "devplan-web" redirectUris
# you set in ../getting-started/src/keycloak/devplan-realm.json)
DEVPLAN_APP_BASE_URL=http://localhost:8090

# Keycloak, as the BROWSER reaches it (must match ../getting-started's KEYCLOAK_PUBLIC_URL)
DEVPLAN_KEYCLOAK_PUBLIC_URL=http://localhost:8280
DEVPLAN_KEYCLOAK_ISSUER=http://localhost:8280/realms/devplan
# Keycloak/engine, as THIS CONTAINER reaches them over the shared "casefabric_network" -
# container-to-container, so these normally do NOT change between local and production:
DEVPLAN_KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/devplan
DEVPLAN_KEYCLOAK_ADMIN_URL=http://keycloak:8080/admin/realms/devplan
DEVPLAN_ENGINE_URL=http://case-engine:2027

# Must match the "secret" you set on the devplan-backend client in
# ../getting-started/src/keycloak/devplan-realm.json
DEVPLAN_BACKEND_CLIENT_SECRET=change-me-to-match-keycloak-client-secret

# This app's own database (separate from the case engine's database)
DEVPLAN_DB_USER=devplan
DEVPLAN_DB_PASSWORD=change-me-to-a-strong-password
DEVPLAN_DB_NAME=devplan
DEVPLAN_DB_PORT=5433

# Token the engine uses to call this app's internal mail relay (keep secret, only used
# container-to-container)
DEVPLAN_MAIL_RELAY_TOKEN=change-me-to-a-random-value

# Dev-only fake SMTP (mailcatcher, from ../getting-started). Point this at a real SMTP
# server/relay before going to production mail delivery.
SPRING_MAIL_HOST=mailcatcher
